# Required by the web app. Copy this file to .env.local and replace placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Used only by scripts/provision-admin.mjs. Never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
ADMIN_USERNAME=anas
ADMIN_PASSWORD=choose-a-strong-password-for-provisioning

# Dedicated disposable test project only. Never point integration tests at production.
RUN_SUPABASE_INTEGRATION=0
SUPABASE_TEST_URL=https://your-test-project.supabase.co
SUPABASE_TEST_ANON_KEY=your-test-anon-key
SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-service-role-key
